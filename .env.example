# Copy to .env (repo root) and fill in. Read by backend/app/config.py.

# Apify (all collectors)
APIFY_TOKEN=
APIFY_TOKEN1=

# LLM provider: ollama (default), bedrock, or none
LLM_PROVIDER=ollama

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Bedrock (only when LLM_PROVIDER=bedrock)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=eu-north-1
BEDROCK_MODEL_ID=

# Database: the Neon PostgreSQL URL (postgresql://user:password@host/db?sslmode=require).
# Leave empty to use the local SQLite file backend/data/sld 1.db.
DATABASE_URL=

# Overview reporting time zone (IANA), where "New Today" starts
REPORT_TZ=UTC

# Zero-shot classifier: a Hugging Face token (fine-grained, "Make calls to
# Inference Providers") sends classification to the HF Inference API. Leave it
# empty to load the model in-process (pip install -r backend/requirements-local-model.txt).
HF_TOKEN=

# Comma-separated browser origins allowed by CORS (default: the Vite dev server)
CORS_ORIGINS=
