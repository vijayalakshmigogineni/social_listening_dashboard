# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored and must never be committed.
#
# Apify credentials: https://console.apify.com/account/integrations
# Both tokens below are separate free-tier Apify accounts, each with its own
# monthly allowance. The collection scripts pick between them per source.

# Primary Apify token — used by the Reddit and LinkedIn collection scripts.
APIFY_TOKEN=

# Apify actor run ID that linkedin/fetch_linkedin.py pulls its dataset from.
# Get this from the run's URL in the Apify console.
APIFY_RUN_ID=

# Second Apify token — used by the Facebook collection scripts
# (problem-intelligence/facebook/). Override which one is used by setting
# FB_APIFY_TOKEN_VAR to either APIFY_TOKEN or APIFY_TOKEN1.
APIFY_TOKEN1=
