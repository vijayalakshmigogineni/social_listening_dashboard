    "name": "Dan Choi, MD, FAAOS",
    "url": "https://x.com/drdanchoi",
    "avatarUrl": "https://pbs.twimg.com/profile_images/1863224613804589057/Z5R3NR0C_normal.jpg",
    "verified": false,
    "isBlueVerified": true
   },
   "metrics": {
