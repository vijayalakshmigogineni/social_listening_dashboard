          "author_profile_url": null,
          "date": "June 18, 2009, 11:04:22 AM",
          "date_raw": "\u00ab Reply #16 on: June 18, 2009, 11:04:22 AM \u00bb",
          "post_text": "That would be difficult for me too Linda, I just don't know her system to help her see if its possible. Customer service should be able to assist.",
          "post_text_chars": 146,
          "location": null,
          "poster_fields_present": [
